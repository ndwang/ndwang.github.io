---
const year = new Date().getFullYear();
const socials = [
  { href: "mailto:nw285@cornell.edu", label: "Email" },
  { href: "https://github.com/ndwang", label: "GitHub" },
  {
    href: "https://scholar.google.com/citations?user=bOLfUJQAAAAJ",
    label: "Scholar",
  },
  { href: "https://inspirehep.net/authors/2137533", label: "INSPIRE" },
];
---

<footer class="site-footer">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap outro">
    <p class="label"><span class="label-index">05</span> End of beamline</p>
    <p class="signoff">Have a beam to tame or a model to train?</p>
    <a href="mailto:nw285@cornell.edu" class="collide" data-magnetic>
      <span class="collide-text">Let's collide</span>
      <span class="collide-arrow" aria-hidden="true">→</span>
    </a>
  </div>
  <div class="wrap grid">
    <nav class="cell links" aria-label="Social links">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith("http") ? "_blank" : undefined}
            rel="noopener"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
    <div class="cell sig">
      <span>© {year} Ningdong Wang</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    margin-top: 7rem;
    background: linear-gradient(rgba(255, 92, 51, 0.04), transparent 40%);
  }

  .outro {
    padding-block: clamp(3.5rem, 8vh, 6rem) 3rem;
  }

  .signoff {
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 420;
    line-height: 1.3;
    max-width: 24em;
    margin: 1.6rem 0 0.6rem;
    color: var(--ink-mute);
  }

  /* the giant outlined invitation — fills with ion heat on hover */
  .collide {
    display: inline-flex;
    align-items: baseline;
    gap: 0.18em;
    font-family: var(--display);
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(240, 237, 230, 0.5);
    transition:
      color 350ms ease,
      -webkit-text-stroke-color 350ms ease;
    will-change: transform;
  }

  .collide-arrow {
    -webkit-text-stroke: 0;
    color: var(--ion);
    font-weight: 560;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collide:hover {
    color: var(--ion-bright);
    -webkit-text-stroke-color: var(--ion-bright);
  }

  .collide:hover .collide-arrow {
    transform: translateX(0.25em);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.6rem 2rem;
    border-top: 1px solid var(--hairline);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .cell {
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
  }

  .links a {
    color: var(--ink-mute);
    transition: color 150ms ease;
  }

  .links a:hover {
    color: var(--ion-bright);
  }
</style>
