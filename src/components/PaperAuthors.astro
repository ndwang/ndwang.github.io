---
import { isLeadAuthor } from "../lib/content.js";
const { author = "", mla = false } = Astro.props;
const names = author.split(" and ").map((name, index) => {
  const parts = name.split(",").map((part) => part.trim());
  if (parts.length !== 2) return name;
  return mla && index === 0 ? `${parts[0]}, ${parts[1]}` : `${parts[1]} ${parts[0]}`;
});
// MLA lists the first author's full name followed by et al. for three or more.
const abbreviated = mla && names.length >= 3;
const displayed = abbreviated ? names.slice(0, 1) : names;
---

{displayed.map((name, index) => (
  <>
    {index > 0 && (mla ? ", and " : ", ")}
    {index === 0 && isLeadAuthor(author) ? <strong>{name}</strong> : name}
  </>
))}
{abbreviated && ", et al."}
<style>
  strong {
    color: var(--ink);
    font-weight: 700;
  }
</style>
