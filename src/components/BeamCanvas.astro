---
/*
  The site's signature mark, upgraded from a drawing to a machine:
  a real-time 2D beam-dynamics sketch. Two counter-circulating bunched
  beams — ions (gold) and electrons (cyan) — orbit intersecting rings,
  oscillate radially (betatron motion), bend around the visitor's cursor
  as if it were a magnet, and register collision events at IP-01.
  Updates any [data-events] element with the running event count.
*/
---

<div class="beam-stage" aria-hidden="true">
  <canvas id="beam-canvas"></canvas>
</div>

<style>
  .beam-stage,
  .beam-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .beam-stage {
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  const TAU = Math.PI * 2;
  const GOLD = "217,166,72";
  const GOLD_B = "240,196,104";
  const CYAN = "88,207,227";
  const CYAN_B = "140,232,247";

  interface Particle {
    theta0: number;
    amp: number;
    freq: number;
    phase: number;
    alpha: number;
    halo: boolean;
    ox: number;
    oy: number;
    px: number;
    py: number;
    fresh: boolean;
  }

  interface Spark {
    vx: number;
    vy: number;
    t0: number;
    life: number;
    color: string;
  }

  function makeRing(dir: number, omega: number, core: string, glow: string) {
    const particles: Particle[] = [];
    const bunches = 3;
    for (let i = 0; i < 112; i++) {
      const halo = i % 4 === 3;
      const spread = (Math.random() + Math.random() + Math.random()) / 1.5 - 1; // ~triangular
      const theta0 = halo
        ? Math.random() * TAU
        : (i % bunches) * (TAU / bunches) + spread * 0.5;
      particles.push({
        theta0,
        amp: 2 + Math.random() * 9,
        freq: 0.8 + Math.random() * 2.2,
        phase: Math.random() * TAU,
        alpha: halo ? 0.1 + Math.random() * 0.15 : 0.35 + Math.random() * 0.55,
        halo,
        ox: 0,
        oy: 0,
        px: 0,
        py: 0,
        fresh: true,
      });
    }
    return { dir, omega, bunches, core, glow, particles };
  }

  function init(): (() => void) | null {
    const canvas = document.getElementById(
      "beam-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return null;
    const stage = canvas.parentElement as HTMLElement;
    const host = (canvas.closest("[data-beam-host]") as HTMLElement) ?? stage;
    const ctx = canvas.getContext("2d");
    if (!ctx) return null;

    const counters = document.querySelectorAll("[data-events]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const rings = [
      makeRing(1, TAU / 16, GOLD_B, GOLD),
      makeRing(-1, TAU / 10, CYAN_B, CYAN),
    ];

    let w = 0;
    let h = 0;
    let geo: {
      c: { x: number; y: number }[];
      R: number;
      ip: { x: number; y: number };
      ipAngle: number[];
    } | null = null;

    function layout() {
      const rect = stage.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.max(1, Math.round(w * dpr));
      canvas!.height = Math.max(1, Math.round(h * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      let cx: number, cy: number, R: number;
      if (w > 880) {
        cx = Math.min(w * 0.74, w - 270);
        cy = h * 0.47;
        R = Math.min(h * 0.36, w * 0.2, 290);
      } else {
        cx = w / 2;
        cy = 230;
        R = Math.min(w * 0.33, 150);
      }
      const d = R * 0.6;
      const ipY = cy - Math.sqrt(R * R - d * d);
      // geometry moved: drop trail anchors so particles don't smear
      for (const ring of rings) for (const p of ring.particles) p.fresh = true;
      geo = {
        c: [
          { x: cx - d, y: cy },
          { x: cx + d, y: cy },
        ],
        R,
        ip: { x: cx, y: ipY },
        ipAngle: [Math.atan2(ipY - cy, d), Math.atan2(ipY - cy, -d)],
      };
    }

    // pointer acts as a steering magnet
    let mx = -9999;
    let my = -9999;
    const onPointer = (e: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      mx = e.clientX - rect.left;
      my = e.clientY - rect.top;
    };
    const onLeave = () => {
      mx = -9999;
      my = -9999;
    };

    let sparks: Spark[] = [];
    let events = 0;
    let lastBurst = -10;
    let ipFlash = -10;

    function angDiff(a: number, b: number) {
      let d = (a - b) % TAU;
      if (d > Math.PI) d -= TAU;
      if (d < -Math.PI) d += TAU;
      return Math.abs(d);
    }

    function drawStatic() {
      const g = geo!;
      ctx!.save();
      ctx!.lineWidth = 1;
      for (const c of g.c) {
        ctx!.strokeStyle = "rgba(233,228,214,0.09)";
        ctx!.beginPath();
        ctx!.arc(c.x, c.y, g.R, 0, TAU);
        ctx!.stroke();
        // instrument ticks
        ctx!.strokeStyle = "rgba(233,228,214,0.14)";
        ctx!.setLineDash([1.5, (TAU * (g.R + 9)) / 90 - 1.5]);
        ctx!.lineWidth = 5;
        ctx!.beginPath();
        ctx!.arc(c.x, c.y, g.R + 9, 0, TAU);
        ctx!.stroke();
        ctx!.setLineDash([]);
        ctx!.lineWidth = 1;
      }
      // IP crosshair
      const { x, y } = g.ip;
      ctx!.strokeStyle = "rgba(168,161,147,0.8)";
      for (const [x1, y1, x2, y2] of [
        [x, y - 20, x, y - 8],
        [x, y + 8, x, y + 20],
        [x - 20, y, x - 8, y],
        [x + 8, y, x + 20, y],
      ]) {
        ctx!.beginPath();
        ctx!.moveTo(x1, y1);
        ctx!.lineTo(x2, y2);
        ctx!.stroke();
      }
      ctx!.fillStyle = "rgba(236,231,217,0.95)";
      ctx!.beginPath();
      ctx!.arc(x, y, 2.4, 0, TAU);
      ctx!.fill();
      // annotations
      ctx!.font = "11px 'IBM Plex Mono', ui-monospace, monospace";
      ctx!.fillStyle = `rgba(${GOLD},0.8)`;
      ctx!.textAlign = "right";
      ctx!.fillText("p / A", g.c[0].x - g.R - 16, g.c[0].y + 4);
      ctx!.fillStyle = `rgba(${CYAN},0.8)`;
      ctx!.textAlign = "left";
      ctx!.fillText("e⁻", g.c[1].x + g.R + 16, g.c[1].y + 4);
      ctx!.fillStyle = "rgba(110,105,94,0.9)";
      ctx!.fillText("IP — 01", x + 26, y - 14);
      ctx!.restore();
    }

    function render(t: number) {
      const g = geo!;
      ctx!.clearRect(0, 0, w, h);
      drawStatic();
      ctx!.save();
      ctx!.globalCompositeOperation = "lighter";

      for (let ri = 0; ri < rings.length; ri++) {
        const ring = rings[ri];
        const c = g.c[ri];
        for (const p of ring.particles) {
          const theta = p.theta0 + ring.dir * ring.omega * t;
          const rr = g.R + p.amp * Math.sin(p.freq * t + p.phase);
          let x = c.x + rr * Math.cos(theta);
          let y = c.y + rr * Math.sin(theta);

          // cursor deflection with spring-back
          const dx = x - mx;
          const dy = y - my;
          const d2 = dx * dx + dy * dy;
          let tx = 0;
          let ty = 0;
          if (d2 < 140 * 140 && d2 > 0.01) {
            const dist = Math.sqrt(d2);
            const f = (1 - dist / 140) ** 2 * 36;
            tx = (dx / dist) * f;
            ty = (dy / dist) * f;
          }
          p.ox += (tx - p.ox) * 0.1;
          p.oy += (ty - p.oy) * 0.1;
          x += p.ox;
          y += p.oy;

          if (p.fresh) {
            p.px = x;
            p.py = y;
            p.fresh = false;
          }
          // motion streak
          ctx!.strokeStyle = `rgba(${ring.core},${p.alpha})`;
          ctx!.lineWidth = 1.5;
          ctx!.beginPath();
          ctx!.moveTo(p.px, p.py);
          ctx!.lineTo(x, y);
          ctx!.stroke();
          // soft glow
          ctx!.fillStyle = `rgba(${ring.glow},${p.alpha * 0.16})`;
          ctx!.beginPath();
          ctx!.arc(x, y, 3.6, 0, TAU);
          ctx!.fill();
          p.px = x;
          p.py = y;
        }
      }

      // collision detection: a gold and a cyan bunch crossing IP together
      if (t - lastBurst > 0.7) {
        const atIP = rings.map((ring, ri) => {
          for (let b = 0; b < ring.bunches; b++) {
            const ang = (b * TAU) / ring.bunches + ring.dir * ring.omega * t;
            if (angDiff(ang, g.ipAngle[ri]) < 0.13) return true;
          }
          return false;
        });
        if (atIP[0] && atIP[1]) {
          lastBurst = t;
          ipFlash = t;
          events++;
          const label = String(events).padStart(4, "0");
          counters.forEach((el) => (el.textContent = label));
          for (let i = 0; i < 18; i++) {
            const a = Math.random() * TAU;
            const v = 30 + Math.random() * 170;
            sparks.push({
              vx: Math.cos(a) * v,
              vy: Math.sin(a) * v,
              t0: t,
              life: 0.4 + Math.random() * 0.5,
              color: [GOLD_B, CYAN_B, "236,231,217"][i % 3],
            });
          }
        }
      }

      // sparks fly out from the IP and fade
      sparks = sparks.filter((s) => t - s.t0 < s.life);
      for (const s of sparks) {
        const age = t - s.t0;
        const k = 1 - age / s.life;
        ctx!.fillStyle = `rgba(${s.color},${k * 0.9})`;
        ctx!.beginPath();
        ctx!.arc(g.ip.x + s.vx * age, g.ip.y + s.vy * age, 1.4, 0, TAU);
        ctx!.fill();
      }

      // expanding flash ring at the IP
      const fk = (t - ipFlash) / 0.6;
      if (fk >= 0 && fk < 1) {
        ctx!.strokeStyle = `rgba(236,231,217,${(1 - fk) * 0.7})`;
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.arc(g.ip.x, g.ip.y, 5 + fk * 30, 0, TAU);
        ctx!.stroke();
      }
      ctx!.restore();
    }

    layout();

    if (reduced) {
      render(4.2); // a single composed frame, no motion
      const ro = new ResizeObserver(() => {
        layout();
        render(4.2);
      });
      ro.observe(stage);
      return () => ro.disconnect();
    }

    let raf = 0;
    let running = true;
    let visible = true;
    let simT = 0;
    let prev = performance.now();

    function loop(now: number) {
      simT += Math.min((now - prev) / 1000, 0.05);
      prev = now;
      render(simT);
      raf = requestAnimationFrame(loop);
    }

    function setRunning(on: boolean) {
      if (on === running) return;
      running = on;
      if (on) {
        prev = performance.now();
        raf = requestAnimationFrame(loop);
      } else {
        cancelAnimationFrame(raf);
      }
    }

    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      setRunning(visible && !document.hidden);
    });
    io.observe(stage);
    const onVis = () => setRunning(visible && !document.hidden);
    document.addEventListener("visibilitychange", onVis);

    const ro = new ResizeObserver(layout);
    ro.observe(stage);
    host.addEventListener("pointermove", onPointer);
    host.addEventListener("pointerleave", onLeave);

    raf = requestAnimationFrame(loop);

    return () => {
      cancelAnimationFrame(raf);
      io.disconnect();
      ro.disconnect();
      document.removeEventListener("visibilitychange", onVis);
      host.removeEventListener("pointermove", onPointer);
      host.removeEventListener("pointerleave", onLeave);
    };
  }

  let cleanup: (() => void) | null = null;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = init();
  });
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
