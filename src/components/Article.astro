---
import Base from "../layouts/Base.astro";
import { formatDate } from "../lib/content.js";
const { entry, kind = "post" } = Astro.props;
const isPost = kind === "post";
const headings = (entry.headings || []).filter((heading) => heading.depth === 2);
---

<Base title={entry.title} description={entry.description} section={isPost ? "blog" : "projects"}>
  <header class="article-header">
    <a class="text-link article-back" href={isPost ? "/blog/" : "/projects/"}>
      {isPost ? "Back to blog" : "Back to projects"}
    </a>
    {entry.date && (
      <p class="eyebrow">
        <time datetime={new Date(entry.date).toISOString()}>{formatDate(entry.date)}</time>
      </p>
    )}
    <h1>{entry.title}</h1>
    <p class="lede">{entry.description}</p>
  </header>
  <div class="article-layout">
    <aside class="article-toc">
      {headings.length > 0 && (
        <nav aria-label="Contents">
          <p class="eyebrow">Contents</p>
          <ol>
            {headings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </aside>
    <article class="article-body prose" set:html={entry.html} />
  </div>
  <footer class="article-end">
    <a class="text-link" href={isPost ? "/blog/" : "/projects/"}>
      {isPost ? "Back to blog" : "Back to projects"}
    </a>
  </footer>
</Base>
<script>
  document.querySelectorAll<HTMLIFrameElement>("iframe[data-autosize]").forEach((frame) => {
    let observer: ResizeObserver;
    const fitContent = () => {
      const body = frame.contentDocument?.body;
      if (!body || !body.children.length) return;
      observer?.disconnect();
      // Measure the body rather than scrollHeight, which includes the old iframe height.
      observer = new ResizeObserver(() => {
        frame.style.height = `${Math.ceil(body.getBoundingClientRect().height)}px`;
      });
      observer.observe(body);
    };
    frame.addEventListener("load", fitContent);
    if (frame.contentDocument?.readyState === "complete") fitContent();
  });
</script>
<style>
  .article-header {
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid var(--line);
  }
  .article-back {
    margin-bottom: 3.5rem;
  }
  .article-header h1 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(2.3rem, 5vw, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
    max-width: 21ch;
    margin: 1.5rem 0;
  }
  .article-header > .lede {
    max-width: 62ch;
  }
  .article-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 720px);
    gap: clamp(2rem, 5vw, 5rem);
    padding-top: 3rem;
    justify-content: space-between;
  }
  .article-toc {
    align-self: start;
    position: sticky;
    top: 7rem;
    max-height: calc(100vh - 9rem);
    overflow: auto;
    padding-bottom: 1rem;
  }
  .article-toc ol {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }
  .article-toc li {
    margin: 0 0 0.85rem;
  }
  .article-toc li a {
    font-size: 0.76rem;
    line-height: 1.5;
    text-decoration: none;
    color: var(--muted);
  }
  .article-toc li a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .article-body {
    min-width: 0;
  }
  .article-end {
    margin-top: 5rem;
    padding: 2rem 0;
  }
  @media (max-width: 850px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      max-width: 720px;
      margin-inline: auto;
    }
    .article-toc {
      position: static;
      max-height: none;
    }
    .article-toc ol {
      columns: 2;
      margin: 1rem 0;
    }
    .article-toc li {
      break-inside: avoid;
    }
  }
  @media (max-width: 500px) {
    .article-toc ol {
      columns: 1;
    }
    .article-header {
      padding-top: 2rem;
    }
    .article-back {
      margin-bottom: 2rem;
    }
  }
  @media print {
    .article-toc,
    .article-back,
    .article-end {
      display: none;
    }
    .article-layout {
      display: block;
    }
    .article-header h1 {
      font-size: 2.7rem;
    }
  }
</style>
