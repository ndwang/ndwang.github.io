---
const path = Astro.url.pathname;
const items = [
  { href: "/blog/", label: "Writing" },
  { href: "/projects/", label: "Projects" },
  { href: "/publications/", label: "Publications" },
  { href: "/cv/", label: "CV" },
];
const isActive = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Home">
      <span class="mark" aria-hidden="true">
        <span class="dot dot--gold"></span>
        <span class="dot dot--cyan"></span>
      </span>
      <span class="name">Ningdong&nbsp;Wang</span>
    </a>
    <nav aria-label="Primary">
      {
        items.map((it) => (
          <a
            href={it.href}
            class:list={["nav-link", { active: isActive(it.href) }]}
          >
            {it.label}
          </a>
        ))
      }
    </nav>
    <span class="clock" data-clock aria-hidden="true">ITHACA --:--:--</span>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(8, 11, 16, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .mark {
    position: relative;
    width: 18px;
    height: 12px;
    flex: none;
  }

  .dot {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    transform: translateY(-50%);
    mix-blend-mode: screen;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dot--gold {
    left: 0;
    background: var(--gold);
  }

  .dot--cyan {
    right: 0;
    background: var(--cyan);
  }

  /* the two beams collide when you aim at home */
  .brand:hover .dot--gold {
    transform: translate(4.5px, -50%);
  }

  .brand:hover .dot--cyan {
    transform: translate(-4.5px, -50%);
  }

  nav {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 2rem);
    margin-left: auto;
  }

  .nav-link {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding: 0.4em 0;
    border-bottom: 1px solid transparent;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--gold-bright);
    border-bottom-color: var(--gold);
  }

  .clock {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .clock {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .brand .name {
      display: none;
    }
  }
</style>

<script>
  let timer: ReturnType<typeof setInterval> | undefined;

  function tick() {
    const el = document.querySelector("[data-clock]");
    if (!el) return;
    const t = new Date().toLocaleTimeString("en-US", {
      hour12: false,
      timeZone: "America/New_York",
    });
    el.textContent = `ITHACA ${t}`;
  }

  document.addEventListener("astro:page-load", () => {
    clearInterval(timer);
    tick();
    timer = setInterval(tick, 1000);
  });
</script>
