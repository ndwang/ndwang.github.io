---
/*
  The site's signature machine, scoped to the hero: a GPU particle field
  (~40k points) of two counter-circulating bunched beams — ions (vermilion)
  and electrons (periwinkle) — on intersecting tilted rings. The cursor
  acts as a repulsor magnet on the field; bunch crossings at the
  interaction point increment any [data-events] element.

  It lives inside the hero section and scrolls away with it, so reading
  the rest of the page is never contested by motion. Honors
  prefers-reduced-motion with a single static frame, and pauses whenever
  the hero is offscreen or the tab is hidden.
*/
---

<div class="field" aria-hidden="true" data-field-stage>
  <canvas data-particle-field></canvas>
</div>

<style>
  .field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .field canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import * as THREE from "three";

  const TAU = Math.PI * 2;
  const RING_R = 2.6;
  const RING_D = 1.45; // half-distance between ring centers; < R so they cross
  const OMEGA = 0.55; // angular speed of circulation, rad/s
  const BUNCHES = 3;
  // phase offset of the electron ring's bunches, chosen so that bunches from
  // both rings arrive at the interaction point together (collisions happen)
  const PHASE1 = Math.PI / 3;

  const vert = /* glsl */ `
    attribute vec4 aRing;     // theta0, ringIx (0|1), radial offset, axial offset
    attribute vec4 aSeed;     // amp, freq, phase, brightness
    attribute float aSpecies;

    uniform float uTime;
    uniform float uPixelRatio;
    uniform float uSize;
    uniform vec3 uMouse;
    uniform float uMouseOn;

    varying float vSpecies;
    varying float vBright;

    // tilt the collider plane toward the camera
    const mat3 TILT = mat3(
      1.0, 0.0, 0.0,
      0.0, 0.42261826, 0.90630779,
      0.0, -0.90630779, 0.42261826
    );

    void main() {
      float dir = aRing.y * 2.0 - 1.0;
      float theta = aRing.x + dir * uTime * ${OMEGA.toFixed(2)};
      float wobble = sin(uTime * aSeed.y + aSeed.z) * aSeed.x;
      float r = ${RING_R.toFixed(2)} + aRing.z + wobble;
      vec3 pos = TILT * vec3(
        cos(theta) * r + dir * ${RING_D.toFixed(2)},
        sin(theta) * r,
        aRing.w + wobble * 0.6
      );

      // cursor repulsor
      vec3 away = pos - uMouse;
      float d2 = dot(away, away);
      pos += normalize(away + vec3(0.0001)) *
        exp(-d2 * 1.4) * 0.85 * uMouseOn;

      vec4 mv = modelViewMatrix * vec4(pos, 1.0);
      gl_Position = projectionMatrix * mv;
      gl_PointSize = uSize * (0.5 + aSeed.w) * uPixelRatio / max(-mv.z, 0.1);

      vSpecies = aSpecies;
      vBright = 0.35 + aSeed.w * 0.65;
    }
  `;

  const frag = /* glsl */ `
    precision highp float;

    varying float vSpecies;
    varying float vBright;

    const vec3 ION = vec3(1.0, 0.42, 0.23);
    const vec3 ELECTRON = vec3(0.62, 0.69, 1.0);

    void main() {
      float d = length(gl_PointCoord - 0.5);
      if (d > 0.5) discard;
      float a = pow(smoothstep(0.5, 0.0, d), 1.7);
      vec3 col = mix(ION, ELECTRON, vSpecies);
      gl_FragColor = vec4(col, a * vBright);
    }
  `;

  function gaussian() {
    return (
      (Math.random() + Math.random() + Math.random() + Math.random() - 2) / 2
    );
  }

  function buildGeometry(count: number) {
    const ring = new Float32Array(count * 4);
    const seed = new Float32Array(count * 4);
    const species = new Float32Array(count);

    for (let i = 0; i < count; i++) {
      const sp = i % 2; // 0 ion, 1 electron
      const halo = i % 5 === 4;

      // bunched longitudinally, gaussian transverse
      const theta0 = halo
        ? Math.random() * TAU
        : (Math.floor(Math.random() * BUNCHES) / BUNCHES) * TAU +
          sp * PHASE1 +
          gaussian() * 0.42;
      ring[i * 4] = theta0;
      ring[i * 4 + 1] = sp;
      ring[i * 4 + 2] = gaussian() * (halo ? 0.4 : 0.1);
      ring[i * 4 + 3] = gaussian() * (halo ? 0.5 : 0.12);

      seed[i * 4] = 0.02 + Math.random() * (halo ? 0.3 : 0.09);
      seed[i * 4 + 1] = 0.8 + Math.random() * 2.4;
      seed[i * 4 + 2] = Math.random() * TAU;
      seed[i * 4 + 3] = halo ? Math.random() * 0.3 : 0.25 + Math.random();
      species[i] = sp;
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute("aRing", new THREE.BufferAttribute(ring, 4));
    geo.setAttribute("aSeed", new THREE.BufferAttribute(seed, 4));
    geo.setAttribute("aSpecies", new THREE.BufferAttribute(species, 1));
    // position attr is required by three even though the shader ignores it
    geo.setAttribute(
      "position",
      new THREE.BufferAttribute(new Float32Array(count * 3), 3),
    );
    geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 30);
    return geo;
  }

  function init(): (() => void) | null {
    const canvas = document.querySelector(
      "[data-particle-field]",
    ) as HTMLCanvasElement | null;
    if (!canvas) return null;
    const stage = canvas.closest("[data-field-stage]") as HTMLElement;

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const count = window.innerWidth < 700 ? 14000 : 42000;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: false,
        alpha: true,
        powerPreference: "high-performance",
      });
    } catch {
      return null; // no WebGL — the dark ground stands alone
    }

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 60);
    camera.position.set(0, 0.4, 7.4);

    const uniforms = {
      uTime: { value: 0 },
      uPixelRatio: { value: Math.min(window.devicePixelRatio || 1, 1.75) },
      uSize: { value: 30 },
      uMouse: { value: new THREE.Vector3(99, 99, 0) },
      uMouseOn: { value: 0 },
    };

    const material = new THREE.ShaderMaterial({
      vertexShader: vert,
      fragmentShader: frag,
      uniforms,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });

    const points = new THREE.Points(buildGeometry(count), material);
    scene.add(points);

    function resize() {
      const rect = stage.getBoundingClientRect();
      const w = Math.max(rect.width, 1);
      const h = Math.max(rect.height, 1);
      const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      renderer.setPixelRatio(dpr);
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      uniforms.uPixelRatio.value = dpr;
      // pull back a bit on narrow screens so the rings fit
      camera.position.z = w < 700 ? 9.6 : 7.4;
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(stage);

    if (reduced) {
      uniforms.uTime.value = 4.2;
      renderer.render(scene, camera);
      const roStatic = new ResizeObserver(() => renderer.render(scene, camera));
      roStatic.observe(stage);
      return () => {
        ro.disconnect();
        roStatic.disconnect();
        points.geometry.dispose();
        material.dispose();
        renderer.dispose();
      };
    }

    // -- cursor as magnet ----------------------------------------------------
    const raycaster = new THREE.Raycaster();
    const planeZ = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
    const ndc = new THREE.Vector2();
    const hit = new THREE.Vector3();
    let mouseTarget = 0;
    const onPointer = (e: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      const y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      if (x < -1.1 || x > 1.1 || y < -1.1 || y > 1.1) {
        mouseTarget = 0;
        return;
      }
      ndc.set(x, y);
      raycaster.setFromCamera(ndc, camera);
      if (raycaster.ray.intersectPlane(planeZ, hit)) {
        uniforms.uMouse.value.copy(hit);
        mouseTarget = 1;
      }
    };
    const onPointerOut = () => {
      mouseTarget = 0;
    };
    window.addEventListener("pointermove", onPointer);
    document.documentElement.addEventListener("pointerleave", onPointerOut);

    // -- bunch-crossing event counter ----------------------------------------
    const counters = document.querySelectorAll("[data-events]");
    const ipAngle = [
      Math.atan2(Math.sqrt(RING_R ** 2 - RING_D ** 2), RING_D),
      Math.atan2(Math.sqrt(RING_R ** 2 - RING_D ** 2), -RING_D),
    ];
    let events = 0;
    let lastBurst = -10;
    const angDiff = (a: number, b: number) => {
      let d = (a - b) % TAU;
      if (d > Math.PI) d -= TAU;
      if (d < -Math.PI) d += TAU;
      return Math.abs(d);
    };

    function checkCollisions(t: number) {
      if (t - lastBurst < 0.8) return;
      const atIP = [0, 1].map((ringIx) => {
        const dir = ringIx * 2 - 1;
        for (let b = 0; b < BUNCHES; b++) {
          const ang = (b * TAU) / BUNCHES + ringIx * PHASE1 + dir * OMEGA * t;
          if (angDiff(ang, ipAngle[ringIx]) < 0.12) return true;
        }
        return false;
      });
      if (atIP[0] && atIP[1]) {
        lastBurst = t;
        events++;
        const label = String(events).padStart(4, "0");
        counters.forEach((el) => (el.textContent = label));
      }
    }

    // -- main loop -------------------------------------------------------------
    let raf = 0;
    let running = false;
    let visible = true;
    let simT = 0;
    let prev = performance.now();
    const camDrift = { x: 0, y: 0 };

    function loop(now: number) {
      const dt = Math.min((now - prev) / 1000, 0.05);
      prev = now;
      simT += dt;

      uniforms.uTime.value = simT;
      uniforms.uMouseOn.value += (mouseTarget - uniforms.uMouseOn.value) * 0.08;

      // gentle parallax: the camera leans with the cursor
      camDrift.x += (ndc.x * 0.45 - camDrift.x) * 0.03;
      camDrift.y += (ndc.y * 0.3 - camDrift.y) * 0.03;
      camera.position.x = camDrift.x;
      camera.position.y = 0.4 + camDrift.y;
      camera.lookAt(0, 0, 0);

      points.rotation.y = simT * 0.02;

      checkCollisions(simT);
      renderer.render(scene, camera);
      raf = requestAnimationFrame(loop);
    }

    function setRunning(on: boolean) {
      if (on === running) return;
      running = on;
      if (on) {
        prev = performance.now();
        raf = requestAnimationFrame(loop);
      } else {
        cancelAnimationFrame(raf);
      }
    }

    // run only while the hero is actually on screen
    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      setRunning(visible && !document.hidden);
    });
    io.observe(stage);
    const onVis = () => setRunning(visible && !document.hidden);
    document.addEventListener("visibilitychange", onVis);

    setRunning(true);

    return () => {
      cancelAnimationFrame(raf);
      io.disconnect();
      ro.disconnect();
      document.removeEventListener("visibilitychange", onVis);
      window.removeEventListener("pointermove", onPointer);
      document.documentElement.removeEventListener(
        "pointerleave",
        onPointerOut,
      );
      points.geometry.dispose();
      material.dispose();
      renderer.dispose();
    };
  }

  let cleanup: (() => void) | null = null;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = init();
  });
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
