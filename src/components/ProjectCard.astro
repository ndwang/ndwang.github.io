---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, category, github, link, image } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="card" data-spot>
  <div class="card-top">
    <span
      class:list={[
        "chip",
        category === "research" ? "chip--gold" : "chip--cyan",
      ]}
    >
      {category}
    </span>
    <span class="corner" aria-hidden="true"></span>
  </div>
  {
    image && (
      <a href={href} class="thumb">
        <img src={image} alt={title} loading="lazy" />
      </a>
    )
  }
  <h3 class="title"><a href={href}>{title}</a></h3>
  <p class="summary">{summary}</p>
  <div class="links">
    <a href={href} class="mlink">Details</a>
    {
      github && (
        <a href={github} target="_blank" rel="noopener" class="mlink">
          GitHub
        </a>
      )
    }
    {
      link && (
        <a href={link} target="_blank" rel="noopener" class="mlink">
          Live
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--hairline);
    background: linear-gradient(160deg, var(--bg-card), rgba(14, 18, 25, 0.4));
    transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card:hover {
    transform: translateY(-4px);
  }

  /* cursor-tracking interior glow */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      240px circle at var(--mx) var(--my),
      rgba(240, 196, 104, 0.08),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 300ms ease;
  }

  /* cursor-tracking border highlight, masked to a 1px frame */
  .card::after {
    content: "";
    position: absolute;
    inset: -1px;
    pointer-events: none;
    padding: 1px;
    background: radial-gradient(
      280px circle at var(--mx) var(--my),
      rgba(240, 196, 104, 0.75),
      rgba(88, 207, 227, 0.3) 50%,
      transparent 75%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .card:hover::before,
  .card:hover::after {
    opacity: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .corner {
    width: 14px;
    height: 14px;
    border-top: 1px solid var(--ink-faint);
    border-right: 1px solid var(--ink-faint);
    transition: border-color 300ms ease;
  }

  .card:hover .corner {
    border-color: var(--gold);
  }

  .thumb {
    border: 1px solid var(--hairline);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--bg-raised);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
    transition:
      transform 400ms ease,
      filter 400ms ease;
  }

  .card:hover .thumb img {
    transform: scale(1.04);
    filter: saturate(1);
  }

  .title {
    font-size: 1.375rem;
    font-weight: 500;
  }

  .title a {
    transition: color 150ms ease;
  }

  .title a:hover {
    color: var(--gold-bright);
  }

  .summary {
    color: var(--ink-mute);
    font-size: 0.9875rem;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .links {
    display: flex;
    gap: 1.6rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--hairline);
  }
</style>

<script>
  // delegated so it keeps working across view transitions
  document.addEventListener("pointermove", (e) => {
    const card = (e.target as Element | null)?.closest?.(
      "[data-spot]",
    ) as HTMLElement | null;
    if (!card) return;
    const rect = card.getBoundingClientRect();
    card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
    card.style.setProperty("--my", `${e.clientY - rect.top}px`);
  });
</script>
