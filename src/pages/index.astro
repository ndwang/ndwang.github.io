---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import IdeaStudy from "../components/IdeaStudy.astro";
import PaperAuthors from "../components/PaperAuthors.astro";
import spaceCharge from "../assets/editorial/projects-landscape.png";
import theNextExperiment from "../assets/editorial/blog-landscape.png";
import learningTheDynamics from "../assets/editorial/papers-landscape.png";
import { getPosts, getPapers, isLeadAuthor, formatDate } from "../lib/content.js";
const posts = await getPosts();
const papers = getPapers()
  .filter((paper) => isLeadAuthor(paper.author))
  .slice(0, 3);
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Ningdong
        <br />
        <em>Wang</em>
      </h1>
      <p class="hero-description">
        Researcher and builder.
        <br />
        PhD student at Cornell University.
      </p>
      <div class="hero-actions">
        <a href="/cv/" class="text-link">
          CV
        </a>
      </div>
    </div>
    <IdeaStudy />
  </section>

  <section class="home-section home-blog" aria-labelledby="writing-title">
    <div class="home-scene">
      <Image
        class="home-section-art"
        src={theNextExperiment}
        alt=""
        aria-hidden="true"
        width={1200}
        widths={[480, 960, 1440]}
        sizes="(max-width: 540px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 64px), (max-width: 1432px) calc(100vw - 112px), 1320px"
        format="webp"
        loading="lazy"
      />
      <h2 class="home-section-title" id="writing-title">
        <a class="content-link" href="/blog/">
          Blog
        </a>
      </h2>
    </div>
    <div class="home-posts">
      {posts.map((post, index) => (
        <a class="home-post" href={post.url} aria-labelledby={`home-post-${index}`}>
          <time class="eyebrow" datetime={new Date(post.date).toISOString()}>
            {formatDate(post.date)}
          </time>
          <h3 class="content-link" id={`home-post-${index}`}>
            {post.title}
          </h3>
          <p class="post-description">{post.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section home-projects" aria-labelledby="work-title">
    <div class="home-scene">
      <Image
        class="home-section-art"
        src={spaceCharge}
        alt=""
        aria-hidden="true"
        width={1200}
        widths={[480, 960, 1440]}
        sizes="(max-width: 540px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 64px), (max-width: 1432px) calc(100vw - 112px), 1320px"
        format="webp"
        loading="lazy"
      />
      <h2 class="home-section-title" id="work-title">
        <a class="content-link" href="/projects/">
          Projects
        </a>
      </h2>
    </div>
    <a class="featured-project" href="/projects/spacecharge.jl/" aria-labelledby="home-spacecharge-title">
      <h3 class="content-link" id="home-spacecharge-title">
        SpaceCharge.jl
      </h3>
      <p>A GPU-accelerated Julia package for space charge calculations.</p>
    </a>
  </section>

  <section class="home-section home-papers" aria-labelledby="papers-title">
    <div class="home-scene">
      <Image
        class="home-section-art"
        src={learningTheDynamics}
        alt=""
        aria-hidden="true"
        width={1200}
        widths={[480, 960, 1440]}
        sizes="(max-width: 540px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 64px), (max-width: 1432px) calc(100vw - 112px), 1320px"
        format="webp"
        loading="lazy"
      />
      <h2 class="home-section-title" id="papers-title">
        <a href="/papers/" class="content-link">
          Papers
        </a>
      </h2>
    </div>
    <div class="home-paper-grid">
      {papers.map((paper, index) => (
        <a class="home-paper" href={paper.doi ? `https://doi.org/${paper.doi}` : paper.url || "/papers/"} aria-labelledby={`home-paper-${index}`}>
          <time class="home-paper-year" datetime={String(paper.year)}>
            {paper.year}
          </time>
          <h3 class="content-link" id={`home-paper-${index}`}>
            {paper.title}
          </h3>
          <p>
            <PaperAuthors author={paper.author} mla /> · {paper.booktitle}
          </p>
        </a>
      ))}
    </div>
  </section>
</Base>
