---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import BeamCanvas from "../components/BeamCanvas.astro";
import PubItem from "../components/PubItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostRow from "../components/PostRow.astro";
import { getSelectedPublications } from "../lib/publications";

const selectedPubs = getSelectedPublications();

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base title="Ningdong Wang — Accelerator Physics × AI">
  <!-- ====================================================== hero -->
  <section class="hero" data-beam-host>
    <BeamCanvas />
    <div class="wrap hero-content">
      <div class="hero-text">
        <p class="label rise" style="animation-delay: 80ms">
          <span class="label-index">Cornell University</span> · PhD Candidate
        </p>
        <h1 class="rise" style="animation-delay: 180ms">
          Particle <em class="g">beams</em>,<br />
          meet <em class="c">machine intelligence</em>.
        </h1>
        <p class="lede rise" style="animation-delay: 300ms">
          I'm Ningdong Wang. I study how intense charged-particle beams behave
          inside the <strong>Electron-Ion Collider</strong> — the next great collider
          in the US — and I build AI tools that make that work faster.
        </p>
        <div class="hero-cta rise" style="animation-delay: 420ms">
          <a href="/projects/" class="btn">See the work</a>
          <a href="mailto:nw285@cornell.edu" class="btn btn--ghost"
            >Get in touch</a
          >
        </div>
        <p class="hero-hint rise" style="animation-delay: 560ms">
          The beams are live — steer them with your cursor.
        </p>
      </div>
    </div>
    <div class="wrap">
      <dl class="status rise" style="animation-delay: 600ms">
        <div class="stat">
          <dt>Machine</dt>
          <dd>Electron-Ion Collider</dd>
        </div>
        <div class="stat">
          <dt>Focus</dt>
          <dd>Space-charge simulation &amp; optimization</dd>
        </div>
        <div class="stat">
          <dt>Currently</dt>
          <dd>LLM agents for accelerator physics</dd>
        </div>
        <div class="stat stat--live">
          <dt><span class="live-dot"></span>Detector · IP-01</dt>
          <dd><span class="ev" data-events>0000</span> events recorded</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ====================================================== about -->
  <section class="section wrap" id="about">
    <div class="section-head" data-reveal>
      <div>
        <p class="label"><span class="label-index">01</span> About</p>
        <h2 class="section-title">Beam physics, <em>by day and by GPU</em></h2>
      </div>
      <span class="ghost-num">01</span>
    </div>
    <div class="about-grid">
      <div class="about-prose prose" data-reveal>
        <p>
          I'm a PhD candidate in physics at Cornell University and a research
          assistant at Brookhaven National Laboratory, focused on space charge
          simulation and optimization for the Electron-Ion Collider — work
          recognized by a DOE SCGSR fellowship and a DOE Tigner Traineeship. My
          research centers on how intense charged particle beams evolve under
          collective interactions, with applications to the EIC Strong Hadron
          Cooler and Low Energy Cooler.
        </p>
        <p>
          The other half of my work is teaching machines to do accelerator
          physics: <a href="/projects/beam-vae/">surrogate models</a> that
          propagate whole beam distributions in milliseconds, and
          <a href="/projects/accelerator-agents/">LLM agents</a> that operate
          simulation and control systems — including
          <a href="/projects/bmad-bot/">Bmad-bot</a> and the multi-lab Osprey
          framework deployed across seven DOE facilities.
        </p>
      </div>
      <figure class="portrait" data-reveal style="--reveal-delay: 120ms">
        <img
          src="/images/ningdong_wang_pic.jpg"
          alt="Portrait of Ningdong Wang"
          width="380"
          loading="lazy"
        />
        <figcaption>N. Wang — Ithaca, NY</figcaption>
      </figure>
    </div>
  </section>

  <!-- ====================================================== publications -->
  <section class="section wrap" id="publications">
    <div class="section-head" data-reveal>
      <div>
        <p class="label">
          <span class="label-index">02</span> Selected publications
        </p>
        <h2 class="section-title">On the record</h2>
      </div>
      <a href="/publications/" class="mlink">All publications</a>
      <span class="ghost-num">02</span>
    </div>
    <div class="pub-list">
      {
        selectedPubs.map((pub, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <PubItem pub={pub} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- ====================================================== projects -->
  <section class="section wrap" id="projects">
    <div class="section-head" data-reveal>
      <div>
        <p class="label"><span class="label-index">03</span> Projects</p>
        <h2 class="section-title">Built to be used</h2>
      </div>
      <a href="/projects/" class="mlink">All projects</a>
      <span class="ghost-num">03</span>
    </div>
    <div class="project-grid">
      {
        projects.slice(0, 3).map((project, i) => (
          <div
            class="project-cell"
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- ====================================================== writing -->
  <section class="section wrap" id="writing">
    <div class="section-head" data-reveal>
      <div>
        <p class="label"><span class="label-index">04</span> Writing</p>
        <h2 class="section-title">Notes from the intersection</h2>
      </div>
      <a href="/blog/" class="mlink">All posts</a>
      <span class="ghost-num">04</span>
    </div>
    <div class="post-list">
      {
        posts.map((post, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <PostRow post={post} />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* hero ------------------------------------------------------------ */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: min(92vh, 58rem);
    padding-block: clamp(3rem, 8vh, 6rem) 2.5rem;
  }

  /* fine blueprint grid behind the hero only */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(var(--hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.3;
    mask-image: radial-gradient(
      ellipse 90% 80% at 60% 30%,
      black 30%,
      transparent 75%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 90% 80% at 60% 30%,
      black 30%,
      transparent 75%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .hero-text {
    max-width: 38em;
  }

  h1 {
    font-size: clamp(2.8rem, 6.6vw, 5.2rem);
    font-weight: 460;
    line-height: 1.05;
    margin: 1.5rem 0 1.8rem;
    font-optical-sizing: auto;
  }

  h1 em {
    font-style: italic;
    font-weight: 420;
  }

  h1 .g {
    color: var(--gold-bright);
  }

  h1 .c {
    color: var(--cyan-bright);
  }

  .lede {
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.65;
    color: var(--ink-mute);
    max-width: 30em;
    margin-bottom: 2.2rem;
  }

  .lede strong {
    color: var(--ink);
    font-weight: 500;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-hint {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 2.4rem;
  }

  .hero-hint::before {
    content: "↳ ";
    color: var(--cyan);
  }

  @media (hover: none) {
    .hero-hint {
      display: none;
    }
  }

  /* status strip ----------------------------------------------------- */
  .status {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--hairline);
    margin: 3rem 0 0;
    padding: 0;
    background: rgba(8, 11, 16, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .stat {
    padding: 1.1rem 1.5rem;
    border-left: 1px solid var(--hairline);
  }

  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stat dt {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat dd {
    margin: 0;
    font-size: 1rem;
    color: var(--ink-mute);
  }

  .stat--live dt {
    color: var(--cyan);
  }

  .stat--live .ev {
    font-family: var(--mono);
    font-size: 0.9375rem;
    color: var(--cyan-bright);
    font-variant-numeric: tabular-nums;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan-bright);
    animation: blink 2.2s ease-in-out infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  /* sections ---------------------------------------------------------- */
  .section {
    padding-block: clamp(4rem, 9vh, 7rem) 0;
  }

  /* about ------------------------------------------------------------- */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .portrait {
    position: relative;
    margin: 0;
    padding: 0.9rem;
  }

  /* technical-drawing corner brackets around the portrait */
  .portrait::before,
  .portrait::after {
    content: "";
    position: absolute;
    width: 22px;
    height: 22px;
    transition:
      width 300ms ease,
      height 300ms ease;
  }

  .portrait::before {
    top: 0;
    left: 0;
    border-top: 1px solid var(--gold);
    border-left: 1px solid var(--gold);
  }

  .portrait::after {
    bottom: 0;
    right: 0;
    border-bottom: 1px solid var(--cyan);
    border-right: 1px solid var(--cyan);
  }

  .portrait:hover::before,
  .portrait:hover::after {
    width: 44px;
    height: 44px;
  }

  .portrait img {
    width: 100%;
    filter: saturate(0.9);
  }

  .portrait figcaption {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 0.8rem;
    text-align: right;
  }

  /* lists ------------------------------------------------------------- */
  .pub-list,
  .post-list {
    border-top: 1px solid var(--hairline);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .project-cell {
    display: grid;
  }

  /* responsive ---------------------------------------------------------- */
  @media (max-width: 880px) {
    .hero {
      min-height: 0;
      padding-top: 30rem;
    }

    .hero-text {
      max-width: 100%;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 22rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .status {
      grid-template-columns: 1fr;
    }

    .stat {
      border-left: 0;
      border-top: 1px solid var(--hairline);
      padding-inline: 0;
    }

    .stat:first-child {
      border-top: 0;
    }
  }
</style>
