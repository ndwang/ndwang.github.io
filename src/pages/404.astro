---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Beam lost">
  <div class="wrap lost">
    <p class="code">404 / BEAM LOST</p>
    <h1>This particle left the design orbit.</h1>
    <p class="sub">The page you're looking for was deflected, dumped, or never injected.</p>
    <a href="/" class="mlink">Return to the interaction point</a>
  </div>
</Base>

<style>
  .lost {
    padding-top: 16vh;
    text-align: center;
    max-width: 42rem;
  }

  .code {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: var(--gold);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-bottom: 1rem;
  }

  .sub {
    color: var(--ink-mute);
    font-size: 1.125rem;
    margin-bottom: 2.5rem;
  }
</style>
