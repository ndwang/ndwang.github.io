---
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../lib/content.js";
const posts = await getPosts();
---

<Base title="Blog" description="Articles about software, AI, and scientific computing by Ningdong Wang." section="blog">
  <header class="page-intro">
    <h1 class="display-title" id="writing-heading">
      Blog
    </h1>
  </header>
  <section aria-labelledby="writing-heading">
    <div class="post-list">
      {posts.map((post, index) => (
        <article class="post-row">
          <a class="post-link" href={post.url} aria-labelledby={`post-${index}-title`}>
            <div class="post-date">
              <time datetime={new Date(post.date).toISOString()}>{formatDate(post.date)}</time>
            </div>
            <div class="post-copy">
              <h2 class="content-link" id={`post-${index}-title`}>
                {post.title}
              </h2>
              <p>{post.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</Base>
<style>
  .post-row {
    padding: 0;
  }
  .post-link {
    display: grid;
    grid-template-columns: 145px 1fr;
    gap: 2.2rem;
    padding: 2.8rem 0;
  }
  .post-date time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.7;
  }
  .post-copy h2 {
    font-size: clamp(1.5rem, 2.8vw, 2.3rem);
    font-weight: 500;
    line-height: 1.2;
    max-width: 28ch;
    margin: 0 0 1rem;
  }
  .post-copy p {
    color: var(--muted);
    max-width: 57ch;
    line-height: 1.7;
  }
  @media (max-width: 700px) {
    .post-link {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
