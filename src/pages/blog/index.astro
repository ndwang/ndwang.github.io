---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (
  await getCollection("posts", ({ data }) => !data.draft || !import.meta.env.PROD)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing — Ningdong Wang"
  description="Essays and experiments on accelerator physics, scientific computing, and AI agents."
>
  <div class="wrap page">
    <header class="page-head">
      <p class="label"><span class="label-index">Log</span> Writing</p>
      <h1>Beam time &amp; machine minds</h1>
      <p class="sub">
        Notes from the intersection — accelerator physics, scientific
        computing, and what AI can (and can't) do for science.
      </p>
    </header>
    <div class="post-list">
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(2.5rem, 6vh, 4.5rem);
  }

  .page-head {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    margin: 1.2rem 0 1rem;
  }

  .sub {
    color: var(--ink-mute);
    font-size: 1.125rem;
    max-width: 36em;
  }

  .post-list {
    border-top: 1px solid var(--hairline);
  }
</style>
