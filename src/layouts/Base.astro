---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Ningdong Wang — accelerator physicist at Cornell University working on the Electron-Ion Collider, and builder of AI tools for science.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050608" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script>
      // arm JS-dependent styling (scroll reveals) as early as possible
      document.documentElement.classList.add("js");
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="beamline" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  main {
    position: relative;
    z-index: 2;
    min-height: 70vh;
  }

  /* scroll progress — beam current filling the pipe across the viewport top */
  .beamline {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 70;
    background: linear-gradient(
      90deg,
      var(--ion),
      var(--ion-bright) 45%,
      var(--electron-bright) 55%,
      var(--electron)
    );
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: left;
    pointer-events: none;
  }
</style>

<script>
  import gsap from "gsap";

  const fine = matchMedia("(pointer: fine)");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  let cursorArmed = false;

  function initCursor() {
    if (cursorArmed || !fine.matches || reduced.matches) return;
    const dot = document.querySelector(".cursor-dot");
    const ring = document.querySelector(".cursor-ring");
    if (!dot || !ring) return;
    cursorArmed = true;

    const dotX = gsap.quickTo(dot, "x", { duration: 0.08, ease: "power2" });
    const dotY = gsap.quickTo(dot, "y", { duration: 0.08, ease: "power2" });
    const ringX = gsap.quickTo(ring, "x", { duration: 0.35, ease: "power3" });
    const ringY = gsap.quickTo(ring, "y", { duration: 0.35, ease: "power3" });

    document.addEventListener("pointermove", (e) => {
      document.documentElement.classList.add("cursor-on");
      dotX(e.clientX);
      dotY(e.clientY);
      ringX(e.clientX);
      ringY(e.clientY);
    });
    document.addEventListener("pointerover", (e) => {
      const hot = (e.target as Element | null)?.closest?.(
        "a, button, [data-magnetic]",
      );
      document.documentElement.classList.toggle("cursor-hover", !!hot);
    });
    document.addEventListener("mouseleave", () =>
      document.documentElement.classList.remove("cursor-on"),
    );
  }

  /* magnetic pull on [data-magnetic] elements */
  function initMagnetic() {
    if (!fine.matches || reduced.matches) return;
    document
      .querySelectorAll<HTMLElement>("[data-magnetic]:not([data-mag-armed])")
      .forEach((el) => {
        el.dataset.magArmed = "1";
        const toX = gsap.quickTo(el, "x", { duration: 0.4, ease: "power3" });
        const toY = gsap.quickTo(el, "y", { duration: 0.4, ease: "power3" });
        el.addEventListener("pointermove", (e) => {
          const r = el.getBoundingClientRect();
          toX((e.clientX - r.left - r.width / 2) * 0.3);
          toY((e.clientY - r.top - r.height / 2) * 0.35);
        });
        el.addEventListener("pointerleave", () => {
          toX(0);
          toY(0);
        });
      });
  }

  function initPage() {
    // -- scroll reveals -----------------------------------------------------
    const revealEls = document.querySelectorAll(
      "[data-reveal]:not(.is-revealed)",
    );
    if (revealEls.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
      );
      revealEls.forEach((el) => io.observe(el));
    }

    // -- beamline scroll progress -------------------------------------------
    const root = document.documentElement;
    const onScroll = () => {
      const max = root.scrollHeight - root.clientHeight;
      root.style.setProperty(
        "--scroll-progress",
        max > 0 ? String(Math.min(1, window.scrollY / max)) : "0",
      );
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", onScroll),
      { once: true },
    );

    initCursor();
    initMagnetic();
  }

  document.addEventListener("astro:page-load", initPage);
</script>
